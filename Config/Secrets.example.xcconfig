// Copy to Secrets.xcconfig (gitignored) and fill in your Desktop OAuth client.
GOOGLE_CLIENT_ID = YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = YOUR_DESKTOP_CLIENT_SECRET
// Optional: AI add in the overlay. Claude Haiku 5.5 is used first, GPT-6.1 Sol is the backup.
// Keys can also be pasted in Preferences, which stores them in Keychain.
ANTHROPIC_API_KEY =
// Only for Anthropic keys that are not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID =
OPENAI_API_KEY =
// Optional, without an Apple developer team: sign with a local code-signing certificate so the
// Keychain keeps trusting the app across rebuilds (otherwise every build asks for Keychain access).
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Your Certificate Name
